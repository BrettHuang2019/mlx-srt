#!/bin/bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CLI_BIN="$PROJECT_ROOT/.venv/bin/mlx-srt"

if [ ! -x "$CLI_BIN" ]; then
  echo "Error: mlx-srt environment not found at $CLI_BIN" >&2
  echo "Create it first, for example:" >&2
  echo "  cd $PROJECT_ROOT && python3 -m venv .venv && .venv/bin/pip install -e '.[test]'" >&2
  exit 1
fi

exec "$CLI_BIN" "$@"
